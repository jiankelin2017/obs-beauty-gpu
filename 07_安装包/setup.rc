#include <winver.h>
// 101 = plugin dll. The old package also embedded the same dll as id 1,
// which setup.cpp never reads -- dropped to stop paying for it twice.
// 102/103 = runtime + face model, so a fresh install works without manual copies.
// 104 = third-party license text (MIT requires it when redistributing the above).
// 105 = this project's own license (GPL-2.0). Ships with the installer so the
//       recipient has the terms, and because GPL requires the license text to
//       accompany distribution.
// 106 = ONNX Runtime's OWN third-party notices (abseil, protobuf, ...).
//       THIRD-PARTY-NOTICES.md covers ORT itself; this covers ORT's deps.
//       Verbatim copy of the upstream file, never edited.
// 107 = COPYRIGHT.md. 105 must stay byte-identical to the FSF text or GitHub
//       classifies the project as "Other", so the copyright line and the
//       scope note live here instead of at the top of LICENSE.
// 108 = the top-level "Beauty" menu panel (obs-beauty-ui.dll). It is a SECOND,
//       independent obs module with its own OBS_DECLARE_MODULE(); the filter
//       dll cannot register that menu. 3.2.3 deleted it on install without
//       carrying a copy, which is why the menu entry vanished -- it ships
//       here from 3.2.4 on.
101 RCDATA "obs-beauty.dll"
102 RCDATA "onnxruntime.dll"
103 RCDATA "yunet.onnx"
104 RCDATA "THIRD-PARTY-NOTICES.md"
105 RCDATA "LICENSE"
106 RCDATA "onnxruntime-ThirdPartyNotices.txt"
107 RCDATA "COPYRIGHT.md"
108 RCDATA "obs-beauty-ui.dll"
201 RCDATA "shaders\\detail.hlsl"
202 RCDATA "shaders\\mask.hlsl"
203 RCDATA "shaders\\region.hlsl"
204 RCDATA "shaders\\smooth.hlsl"
205 RCDATA "shaders\\tone.hlsl"
206 RCDATA "shaders\\warp.hlsl"
1 24 "setup.manifest"
