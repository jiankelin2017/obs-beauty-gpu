# ===== OBS 美颜 GPU 版 —— 基线 git 忽略规则 =====
# 本仓库只跟踪「源码 + 着色器 + 验证脚本 + 文档」，不跟踪构建产物与运行时产物。

# 构建产物（由 02_构建/build_gpu.ps1 生成）
02_构建/*.dll
02_构建/*.exe
02_构建/*.lib
02_构建/*.exp
02_构建/build/
02_构建/out/
02_构建/obj/
02_构建/obj_ui/

# 装机备份 & 启动器调试产物（03_装机/7_install_gpu.ps1 会写 backup/，bat 会写调试 txt）
03_装机/backup/
03_装机/*.txt

# 安装包二进制
07_安装包/*.exe
# 2026-11-15 起（3.3.6）：一键安装包作为发布物随源码一起入库分发 ——
# 同一份文件也挂到 GitHub Release v3.3.6 的附件（OBS-Beauty-Setup-3.3.6.exe），
# 仓库内 Setup.exe 与 Release 附件 MD5 相同，两处都是对外下载件。
# 只放行这一份 exe；包内 dll / 运行时 / 模型等载荷仍是构建产物，不入库。
# 代价：每重新打包一次，git 就多一份约 13 MB 的二进制对象，仓库会持续变大。
!07_安装包/Setup.exe
07_安装包/*.dll
# 打包中间产物（rc.exe / cl.exe 每次重编，逐次变化，入库只会制造无意义 diff）
07_安装包/*.obj
07_安装包/*.res
# 07_安装包/shaders 是 build_setup.ps1 从 01_源码/shaders 拷出来的打包中间产物（P2-3）。
# 它曾被误当源码入库，导致「改了源码但忘了重打包」时出现旧 shader 副本。唯一手写源是
# 01_源码/shaders/，另外三处（安装包 / ProgramData 装机目录 / D:\obs_beauty_gpu）全是生成物。
07_安装包/shaders/
# 安装包的其余载荷与生成的版本头：全部由 build_setup.ps1 从仓库别处拷来，
# 源头分别是 06_离线验证/(onnxruntime.dll, models/yunet.onnx)、根目录的
# THIRD-PARTY-NOTICES.md 与 01_源码/beauty_params.h。留在包里只会制造
# 「改了源却漏了副本」的假 diff。（*.dll 已被上一行的 07_安装包/*.dll 覆盖）
07_安装包/yunet.onnx
07_安装包/THIRD-PARTY-NOTICES.md
07_安装包/LICENSE
07_安装包/COPYRIGHT.md
# ORT 官方声明：权威副本在 third_party/（入库），包内这份是构建时拷的
07_安装包/onnxruntime-ThirdPartyNotices.txt
07_安装包/setup_ver.h

# 离线验证运行时依赖（onnxruntime / core_probe 等第三方程序，体积大，非源码）
06_离线验证/*.dll
06_离线验证/*.lib
06_离线验证/*.exp
# build_offline.ps1 的中间产物（每次重编逐次变化，入库只会制造无意义 diff）
06_离线验证/obj_probe/

# 离线探针的临时产物（每次运行重建）：_autorot / _slot 系列是从人脸素材派生的
# 中间帧与掩码输入，既不该入库，也避免把生物特征派生数据提交上去。
# 命中的是数据文件（.raw/.png）。历史口径曾放行 _*.py 判据脚本，两支
# _*_probe.py 已跟踪在库内、文档引用仍有效；2026-11-15 起改为统一口径：
# 下划线前缀一律视为临时产物（见文末「发布整理」段），新增 _*.py 不再入库。
06_离线验证/_*.raw
06_离线验证/_*.png
# 探针还会吐 .rgba / .bin（分割掩码、中间帧）与 .txt（选点日志）。
# 掩码是真人素材的派生数据，和 goldens 同口径：只在本机留。
06_离线验证/_*.rgba
06_离线验证/_*.bin
06_离线验证/_*.txt

# 第三方 ONNX 模型（合计约 140 MB，非源码）。yunet.onnx 例外：生产路径必需，
# 已在库内，用否定规则放行 —— 父目录未被排除，所以 ! 能生效。
06_离线验证/models/*.onnx
!06_离线验证/models/yunet.onnx

# 探针 / 分割实验的临时目录与备份
06_离线验证/backup/
06_离线验证/onnx_probe/
06_离线验证/segtest/
06_离线验证/*.bak_chin*
07_安装包/backup/

# 回归台的输入帧与四条基准（含 .bak 备份）都由真人素材派生，帧内是可辨认的人脸，
# 属个人数据。只在本机保留、不入库；首次 clone 后需自备素材重采（含 * 是为了
# 连 *.raw.2.17.2bak 这类备份一起挡住，否则一次 git add -A 就会漏进来）。
# 重采方式见 docs/guides/guide-offline-regression.md「素材与基准」。
06_离线验证/goldens/*.raw
06_离线验证/goldens/*.raw.*

# 02_构建 下部署前手工 Copy-Item 出来的旧 dll 备份（obs-beauty_before_*.dll 等）
02_构建/backup/

# Python 字节码缓存
__pycache__/

# WorkBuddy 项目数据（切勿提交）
.workbuddy/

# 临时 / 系统
*.tmp
Thumbs.db
ehthumbs.db
.DS_Store

# 验收用基线 dll（体积大，且可由 1ad11fc 重新编译得到）
05_验证/baseline/*.dll
05_验证/out/
05_验证/assets/
# 05_验证/tools：A/B 流水线的第三方二进制（ffmpeg.exe ~64 MB + ffpkg.tgz ~22 MB）。
# 与「二进制不入库」同口径；无脚本硬编码该路径，需要时自备，见 05_验证/README.md。
05_验证/tools/

# ===== 2026-11-15 发布整理 =====
# 05/06 里的下划线前缀文件都是临时测试产物（截图、raw、调试脚本），
# 与本仓库既有约定一致：只跟踪「源码 + 着色器 + 验证脚本 + 文档」。
05_验证/_*
06_离线验证/_*.png
06_离线验证/_*.py
06_离线验证/_*.txt
06_离线验证/_*.bin
03_装机/9_run_obs_maskdump.bat

# ===== 2026-11-15 3.3.6 发布：隐私素材零上传 =====
# 不带下划线前缀的对拍图同样是真人素材派生（4 人脸 / 侧脸 / 旋转输入），
# 一并挡住。判据脚本（.py）不受影响，仍可入库；被挡的只有图像与帧数据。
05_验证/*.png
06_离线验证/*.png
06_离线验证/*.raw
06_离线验证/*.rgba
06_离线验证/*.bin
06_离线验证/goldens/*
# 提交时仍用白名单精确 git add，不用 git add -A；以上规则是最后一道兜底。
